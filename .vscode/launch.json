{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run shotqueue",
      "configurations": [
        "Backend (Delve)",
        "Frontend (Vite dev server)"
      ],
      "stopAll": true
    },
    {
      "name": "shotqueue+mocks",
      "configurations": [
        "Backend (Delve)",
        "Frontend (Vite dev server)",
        "Mock Controller",
        "Mock ATEM",
        "Mock UE150 (x3)"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Backend (Delve)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend (Vite dev server)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Mock Controller",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/mocks/mock-controller",
      "cwd": "${workspaceFolder}/mocks/mock-controller",
      "args": ["--port=5000"]
    },
    {
      "name": "Mock ATEM",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx ts-node src/index.ts 9000",
      "cwd": "${workspaceFolder}/mocks/mock-atem"
    },
    {
      "name": "Mock UE150 (x3)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./run-mock-ue150.sh",
      "cwd": "${workspaceFolder}/mocks"
    }
  ]
}
